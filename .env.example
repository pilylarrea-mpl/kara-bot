# Copy to .env for local runs. On Railway, set these as Variables (not committed).

# Telegram bot (from @BotFather)
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
# Your Telegram chat id (Kara only talks to you)
TELEGRAM_CHAT_ID=your-telegram-chat-id

# Anthropic API key (console.anthropic.com) — the brain
ANTHROPIC_API_KEY=sk-ant-...

# Notion internal integration token (notion.so/my-integrations) — shared with the Command Center page
NOTION_TOKEN=ntn_...

# Google Calendar (optional until set up) — base64 of the service-account JSON,
# and the calendar to write to (your email = your primary calendar).
GOOGLE_CREDENTIALS_JSON=
GOOGLE_CALENDAR_ID=pilylarrea@gmail.com

# Gmail (optional until set up) — personal inbox, read + label + draft only (no send).
# Mint these with: GMAIL_CLIENT_ID=.. GMAIL_CLIENT_SECRET=.. node scripts/gmail-auth.js
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=

# Voice-note transcription (optional). Set ONE. Groq is free/fast (console.groq.com);
# OpenAI also works. If neither is set, Kara asks Pilar to type instead.
GROQ_API_KEY=
# OPENAI_API_KEY=

# Timezone for the heartbeat + planning
TZ=America/New_York
